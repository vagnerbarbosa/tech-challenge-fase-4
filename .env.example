# ===========================================
# Azure AI Services Configuration
# ===========================================

# Para desenvolvimento local com mocks, use:
# AZURE_TEXT_ENDPOINT=http://localhost:3001/
# AZURE_SPEECH_KEY=fake-key
# AZURE_SPEECH_REGION=local
# AZURE_VISION_ENDPOINT=http://localhost:3003/
#
# Ou execute: docker-compose -f docker-compose.mock.yml up

# Azure AI Language (Text Analytics)
AZURE_TEXT_KEY=your_text_analytics_key_here
AZURE_TEXT_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# Azure AI Speech Services
AZURE_SPEECH_KEY=your_speech_key_here
AZURE_SPEECH_REGION=brazilsouth

# Azure AI Vision (Image Analysis)
AZURE_VISION_KEY=your_vision_key_here
AZURE_VISION_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# Azure AI Content Safety (Multilingual Risk Detection)
# Detecta violência, autoagressão e conteúdo prejudicial em 100+ idiomas
# Documentação: https://learn.microsoft.com/azure/ai-services/content-safety/
CONTENT_SAFETY_ENABLED=false
AZURE_CONTENT_SAFETY_KEY=your_content_safety_key_here
AZURE_CONTENT_SAFETY_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# Azure Blob Storage (Optional - for file uploads)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=health-media-uploads

# ===========================================
# Application Configuration
# ===========================================
APP_NAME="Multimodal Health Analysis API"
APP_VERSION=0.8.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# ===========================================
# Security
# ===========================================
# Secret key para JWT (futuro) - Spec 007: API Key mínima para MVP, JWT evolutivo
# Atualmente não utilizada (endpoint /token retorna mock). Será usada quando implementar JWT.
SECRET_KEY=your-secret-key-change-in-production

API_KEY_HEADER=X-API-Key

# Security Hardening (Spec 007)
# Master API key - apenas para admin/emergencias (use chaves geradas em prod)
SECURITY_API_KEY=your-security-api-key-here-min-32-chars
SECURITY_ENVIRONMENT=development
SECURITY_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
SECURITY_RATE_LIMIT_PER_MINUTE=60
SECURITY_REDIS_URL=redis://localhost:6379/0

# ===========================================
# Rate Limiting (Azure Free Tier Protection)
# ===========================================
RATE_LIMIT_ENABLED=true
MAX_TEXT_REQUESTS_PER_DAY=160
MAX_SPEECH_MINUTES_PER_DAY=10
MAX_VISION_REQUESTS_PER_DAY=160

# ===========================================
# Database
# ===========================================
DATABASE_URL=sqlite+aiosqlite:///./health_analysis.db
# For production Azure SQL:
# DATABASE_URL=mssql+aioodbc://username:password@server.database.windows.net/dbname?driver=ODBC+Driver+18+for+SQL+Server

# ===========================================
# Redis (Optional - for distributed rate limiting)
# ===========================================
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# ===========================================
# File Upload Configuration
# ===========================================
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png
ALLOWED_AUDIO_EXTENSIONS=wav,mp3,ogg,m4a
ALLOWED_VIDEO_EXTENSIONS=mp4,avi,mov
UPLOAD_TIMEOUT_SECONDS=300

# ===========================================
# Request Timeout Configuration
# ===========================================
# Timeout global para requisições (segundos) - padrão: 5 minutos
REQUEST_TIMEOUT_SECONDS=300
# Timeout estendido para uploads de arquivos (segundos) - padrão: 10 minutos
UPLOAD_TIMEOUT_SECONDS=600
# Timeout por modalidade no processamento multimodal (segundos) - padrão: 60s
MULTIMODAL_TIMEOUT_SECONDS=60

# ===========================================
# Upload Size Limits (Middleware validation)
# ===========================================
# Limite de tamanho por tipo de upload (validação no middleware antes de processar)
# IMPORTANTE: Azure Free Tier = 10 minutos de áudio por dia (300 min/mês)
# Para proteger a quota, limitamos a 10MB (~10 min MP3, ~1 min WAV) = 5 min max
MAX_AUDIO_SIZE_MB=10       # Áudio: conservador para proteger quota Azure (10MB = ~5-10 min)
MAX_AUDIO_DURATION_SECONDS=300  # Máx 5 minutos por arquivo (metade da quota diária)

# Vídeo: processamento local (YOLOv8), não consome quota Azure
# Limite baseado em capacidade de processamento (2 min de vídeo = análise viável)
MAX_VIDEO_SIZE_MB=50       # Vídeo: 2 minutos em qualidade média
MAX_VIDEO_DURATION_SECONDS=120  # Máx 2 minutos (suficiente para análise de postura)

# ===========================================
# LGPD Compliance
# ===========================================
DATA_RETENTION_DAYS=30
ANONYMIZE_PII=true
CONSENT_REQUIRED=true
