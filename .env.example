# ===========================================
# Azure AI Services Configuration
# ===========================================

# Azure AI Language (Text Analytics)
AZURE_TEXT_KEY=your_text_analytics_key_here
AZURE_TEXT_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# Azure AI Speech Services
AZURE_SPEECH_KEY=your_speech_key_here
AZURE_SPEECH_REGION=brazilsouth

# Azure AI Vision (Image Analysis)
AZURE_VISION_KEY=your_vision_key_here
AZURE_VISION_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# Azure Blob Storage (Optional - for file uploads)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=health-media-uploads

# ===========================================
# Application Configuration
# ===========================================
APP_NAME="Multimodal Health Analysis API"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# ===========================================
# Security
# ===========================================
SECRET_KEY=your-secret-key-change-in-production
API_KEY_HEADER=X-API-Key
API_KEY=your-api-key-here

# ===========================================
# Rate Limiting (Azure Free Tier Protection)
# ===========================================
RATE_LIMIT_ENABLED=true
MAX_TEXT_REQUESTS_PER_DAY=160
MAX_SPEECH_MINUTES_PER_DAY=10
MAX_VISION_REQUESTS_PER_DAY=160

# ===========================================
# Database
# ===========================================
DATABASE_URL=sqlite+aiosqlite:///./health_analysis.db
# For production Azure SQL:
# DATABASE_URL=mssql+aioodbc://username:password@server.database.windows.net/dbname?driver=ODBC+Driver+18+for+SQL+Server

# ===========================================
# Redis (Optional - for distributed rate limiting)
# ===========================================
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# ===========================================
# File Upload Configuration
# ===========================================
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png
ALLOWED_AUDIO_EXTENSIONS=wav,mp3,ogg,m4a
ALLOWED_VIDEO_EXTENSIONS=mp4,avi,mov
UPLOAD_TIMEOUT_SECONDS=300

# ===========================================
# LGPD Compliance
# ===========================================
DATA_RETENTION_DAYS=30
ANONYMIZE_PII=true
CONSENT_REQUIRED=true
