            "description": "Informações da API (público)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Validate API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/validate",
              "host": ["{{base_url}}"],
              "path": ["auth", "validate"]
            },
            "description": "Valida se a API Key está funcionando"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Text Analysis",
      "item": [
        {
          "name": "Analyze Text",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texto\": \"Estou me sentindo muito ansiosa e com medo quando ele chega em casa\",\n  \"tipo\": \"diario\",\n  \"patient_id\": \"uuid-anonimo-123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/analyze/text",
              "host": ["{{base_url}}"],
              "path": ["analyze", "text"]
            },
            "description": "Analisa texto para sentimento e riscos. Requer X-API-Key header."
          },
          "response": []
        },
        {
          "name": "Cache Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/analyze/text/cache/stats",
              "host": ["{{base_url}}"],
              "path": ["analyze", "text", "cache", "stats"]
            },
            "description": "Retorna estatísticas do cache de análises de texto"
          },
          "response": []
        },
        {
          "name": "Clear Cache",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/analyze/text/cache/clear",
              "host": ["{{base_url}}"],
              "path": ["analyze", "text", "cache", "clear"]
            },
            "description": "Limpa o cache de análises de texto"
          },
          "response": []
        }
      ]
    },
