{
  "info": {
    "name": "Multimodal Health Analysis API",
    "description": "API para análise multimodal de dados de saúde da mulher (texto, áudio, vídeo)\n\nStatus atual:\n✅ Implementado: Health, Text Analysis, Audio Analysis\n⏳ Pendente: Video, Multimodal",
    "version": "1.1.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Verifica status da API e quotas Azure"
          },
          "response": []
        },
        {
          "name": "Readiness Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ready",
              "host": ["{{base_url}}"],
              "path": ["ready"]
            },
            "description": "Verifica se a API está pronta para receber requisições (Kubernetes/Docker health check)"
          },
          "response": []
        },
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Informações da API"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Text Analysis",
      "item": [
        {
          "name": "Analyze Text",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texto\": \"Estou me sentindo muito ansiosa e com medo quando ele chega em casa\",\n  \"tipo\": \"diario\",\n  \"patient_id\": \"uuid-anonimo-123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/analyze/text",
              "host": ["{{base_url}}"],
              "path": ["analyze", "text"]
            },
            "description": "Analisa texto para sentimento e riscos"
          },
          "response": []
        },
        {
          "name": "Cache Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/analyze/text/cache/stats",
              "host": ["{{base_url}}"],
              "path": ["analyze", "text", "cache", "stats"]
            },
            "description": "Retorna estatísticas do cache de análises de texto"
          },
          "response": []
        },
        {
          "name": "Clear Cache",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/analyze/text/cache/clear",
              "host": ["{{base_url}}"],
              "path": ["analyze", "text", "cache", "clear"]
            },
            "description": "Limpa o cache de análises de texto"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Audio Analysis",
      "item": [
        {
          "name": "Analyze Audio",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/audio.wav"
                },
                {
                  "key": "patient_id",
                  "value": "uuid-anonimo-123",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/analyze/audio",
              "host": ["{{base_url}}"],
              "path": ["analyze", "audio"]
            },
            "description": "Analisa arquivo de áudio (WAV, MP3, OGG) para transcrição, prosódia e riscos"
          },
          "response": []
        },
        {
          "name": "Get Audio Formats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/analyze/audio/formats",
              "host": ["{{base_url}}"],
              "path": ["analyze", "audio", "formats"]
            },
            "description": "Retorna formatos de áudio suportados e limites"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Video Analysis [NÃO IMPLEMENTADO]",
      "item": [
        {
          "name": "Analyze Video",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "video",
                  "type": "file",
                  "src": "/path/to/video.mp4"
                },
                {
                  "key": "tipo",
                  "value": "cirurgia",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/analyze/video",
              "host": ["{{base_url}}"],
              "path": ["analyze", "video"]
            },
            "description": "[PENDENTE] Analisa vídeo (MP4) ou imagem (JPG, PNG) usando YOLOv8 local"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Multimodal Analysis [NÃO IMPLEMENTADO]",
      "item": [
        {
          "name": "Analyze Multimodal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "texto",
                  "value": "Relato do paciente...",
                  "type": "text"
                },
                {
                  "key": "audio",
                  "type": "file",
                  "src": "/path/to/audio.wav"
                },
                {
                  "key": "video",
                  "type": "file",
                  "src": "/path/to/video.mp4"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/analyze/multimodal",
              "host": ["{{base_url}}"],
              "path": ["analyze", "multimodal"]
            },
            "description": "[PENDENTE] Combina análise de texto, áudio e vídeo"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "test-api-key",
      "type": "string"
    }
  ]
}
