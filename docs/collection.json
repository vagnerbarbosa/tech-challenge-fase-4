{
  "info": {
    "name": "Multimodal Health Analysis API",
    "description": "API para análise multimodal de dados de saúde da mulher (texto, áudio, imagem)",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Verifica status da API"
          },
          "response": []
        },
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Informações da API"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Text Analysis",
      "item": [
        {
          "name": "Analyze Text",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texto\": \"Estou me sentindo muito ansiosa e com medo quando ele chega em casa\",\n  \"tipo\": \"diario\",\n  \"patient_id\": \"uuid-anonimo-123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/analyze/text",
              "host": ["{{base_url}}"],
              "path": ["analyze", "text"]
            },
            "description": "Analisa texto para sentimento e riscos"
          },
          "response": []
        },
        {
          "name": "Cache Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/analyze/cache/stats",
              "host": ["{{base_url}}"],
              "path": ["analyze", "cache", "stats"]
            },
            "description": "Retorna estatísticas do cache"
          },
          "response": []
        },
        {
          "name": "Clear Cache",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/analyze/cache/clear",
              "host": ["{{base_url}}"],
              "path": ["analyze", "cache", "clear"]
            },
            "description": "Limpa o cache de análises"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Audio Analysis",
      "item": [
        {
          "name": "Analyze Audio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "audio",
                  "type": "file",
                  "src": "/path/to/audio.wav"
                },
                {
                  "key": "tipo",
                  "value": "consulta",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/analyze/audio",
              "host": ["{{base_url}}"],
              "path": ["analyze", "audio"]
            },
            "description": "Analisa arquivo de áudio (WAV, MP3, OGG)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Image Analysis",
      "item": [
        {
          "name": "Analyze Image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "imagem",
                  "type": "file",
                  "src": "/path/to/image.jpg"
                },
                {
                  "key": "tipo",
                  "value": "foto_consulta",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/analyze/image",
              "host": ["{{base_url}}"],
              "path": ["analyze", "image"]
            },
            "description": "Analisa imagem (JPG, PNG) ou vídeo (MP4)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Multimodal Analysis",
      "item": [
        {
          "name": "Analyze Multimodal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "texto",
                  "value": "Relato do paciente...",
                  "type": "text"
                },
                {
                  "key": "audio",
                  "type": "file",
                  "src": "/path/to/audio.wav"
                },
                {
                  "key": "imagem",
                  "type": "file",
                  "src": "/path/to/image.jpg"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/analyze/multimodal",
              "host": ["{{base_url}}"],
              "path": ["analyze", "multimodal"]
            },
            "description": "Combina análise de texto, áudio e imagem"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "test-api-key",
      "type": "string"
    }
  ]
}
