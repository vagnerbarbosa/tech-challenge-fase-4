# Dockerfile para execução de testes (Spec 007)
FROM python:3.11-slim

# Variáveis de ambiente
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_CREATE=false \
    ENVIRONMENT=testing \
    LOG_LEVEL=DEBUG \
    # Security (Spec 007)
    SECURITY_API_KEY=test-api-key-for-testing \
    SECURITY_ENVIRONMENT=testing \
    SECURITY_RATE_LIMIT_PER_MINUTE=60 \
    SECURITY_CORS_ORIGINS=http://localhost:3000,http://localhost:8000 \
    RATE_LIMIT_ENABLED=true \
    AUDIT_LOG_PATH=/app/logs/audit.log \
    AUDIT_LOG_RETENTION_DAYS=90 \
    AUDIT_LOG_MAX_SIZE_MB=100 \
    ANONYMIZE_PII=true \
    CONSENT_REQUIRED=true

# Instalar dependências do sistema (incluindo FFmpeg + libsndfile para audio)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libffi-dev \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        libgomp1 \
        ffmpeg \
        libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# Instalar Poetry
RUN pip install --no-cache-dir poetry

# Diretório de trabalho
WORKDIR /app

# Copiar arquivos de dependências
COPY pyproject.toml poetry.lock* ./

# Instalar todas as dependências (incluindo dev)
RUN poetry install --no-root

# Copiar código e testes
COPY src/ ./src/
COPY tests/ ./tests/
COPY scripts/ ./scripts/

# Baixar modelo YOLOv8n para testes
RUN python scripts/download_yolo_model.py || echo "Modelo será baixado no runtime"

# Comando padrão para testes
CMD ["poetry", "run", "pytest", "tests/unit/services/test_audio_analysis.py", "-v", "--cov=src", "--cov-report=term"]
